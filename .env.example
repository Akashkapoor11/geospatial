# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Geospatial File Measurement API
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero config — perfect for local development)
DATABASE_URL=sqlite:///./geospatial_api.db

# PostgreSQL (production). Uncomment and set to switch:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/geospatial

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_MB=250

# ─── CORS ─────────────────────────────────────────────────────────────────────
# "*" allows any origin (fine for local dev / assignment review)
# Production: comma-separated list — e.g. "https://example.com,https://api.example.com"
CORS_ALLOWED_ORIGINS=*

# ─── Database schema ──────────────────────────────────────────────────────────
# true  → create tables automatically on startup (SQLite / tests)
# false → use "alembic upgrade head" (production)
AUTO_CREATE_DB=true
